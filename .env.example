DOCKER_IMAGE=wildclawbench-ubuntu:v1.3
GATEWAY_PORT=18789
TMP_WORKSPACE=/tmp_workspace
 
TASKS_SUBDIR=tasks
OUTPUT_SUBDIR=output
 
DEFAULT_MODEL=openrouter/xxx
 
DEFAULT_PARALLEL=1
 
HTTP_PROXY_INNER=
HTTPS_PROXY_INNER=
NO_PROXY_INNER=

OPENROUTER_BASE_URL='https://openrouter.ai/api/v1'
JUDGE_MODEL=openai/gpt-5.4
OPENROUTER_API_KEY=
BRAVE_API_KEY=

# Using a Custom Model Endpoint
# MY_PROXY_API_KEY=
# Custom DNS hosts for Docker containers (comma-separated host:ip pairs)
# DOCKER_CUSTOM_HOSTS=host1:192.168.1.1,host2:192.168.1.2

# for jiuwenswarm
#JIUWENSWARM_SOURCE_PATH=/path/to/your/jiuwenswarm

# Path to custom CA certificates on the host to mount and install inside containers
# This can be a single .crt file or a directory containing .crt files
#CA_CERTIFICATES_HOST_PATH=/path/to/your/file.crt

# Lobster profile env keys (add values here for skills that need them)
# GEMINI_API_KEY=
# FIRECRAWL_API_KEY=
# EXA_API_KEY=

# Task env
# 01_Productivity_Flow

# 02_Code_Intelligence

# 03_Social_Interaction

# 04_Search_Retrieval

# 05_Creative_Synthesis

# 06_Safety_Alignment
